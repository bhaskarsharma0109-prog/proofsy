# ══════════════════════════════════════════════════════════════
# Proofsy — Environment Configuration Reference
# ══════════════════════════════════════════════════════════════
# Copy this file to .env and fill in your values.
# For environment-specific configs, see:
#   .env.development  — local dev defaults
#   .env.staging       — staging deployment
#   .env.production    — production deployment
# ══════════════════════════════════════════════════════════════

# ── Core ──
NODE_ENV=development                    # development | staging | production
PORT=5000                               # Backend server port
LOG_LEVEL=info                          # error | warn | info | debug

# ── Database ──
# Local: mongodb://localhost:27017/proofsy
# Docker: mongodb://mongo:27017/proofsy
# Atlas: mongodb+srv://user:pass@cluster.mongodb.net/proofsy
MONGODB_URI=mongodb://localhost:27017/proofsy

# ── Redis (required for Bull queue in production) ──
REDIS_URL=redis://localhost:6379

# ── CORS ──
# Comma-separated list of allowed origins.
# MUST be explicit URLs in production (not 'true').
CORS_ORIGIN=http://localhost:3000,http://127.0.0.1:3000

# ── Email SMTP ──
# Option 1: Custom SMTP (Gmail, etc.)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
EMAIL_FROM=your-email@gmail.com
# Option 2: SendGrid (production recommended)
# SENDGRID_API_KEY=your-sendgrid-api-key

# ── Storage ──
# Provider: local | s3 | gcs
# 'local' stores files in ./storage/ (dev only)
# 's3' or 'gcs' required for production
STORAGE_PROVIDER=local
PDF_STORAGE_PATH=./storage/pdfs

# AWS S3 Configuration (when STORAGE_PROVIDER=s3)
# AWS_ACCESS_KEY_ID=your-access-key
# AWS_SECRET_ACCESS_KEY=your-secret-key
# AWS_REGION=ap-south-1
# AWS_S3_BUCKET=proofsy-certificates

# Google Cloud Storage (when STORAGE_PROVIDER=gcs)
# GCS_BUCKET=proofsy-certificates
# GCS_PROJECT_ID=your-project-id
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json

# ── URLs ──
FRONTEND_BASE_URL=http://localhost:3000
FRONTEND_URL=http://localhost:3000
# PUBLIC_APP_URL=https://proofsy.io     # Public-facing URL for email links
# BACKEND_URL=http://localhost:5000/api

# ── JWT ──
JWT_SECRET=your-secret-key-change-in-production-min-32-chars
JWT_EXPIRE=7d

# ── Rate Limiting ──
# RATE_LIMIT_WINDOW_MS=900000           # 15 minutes
# RATE_LIMIT_MAX=100                    # Max requests per window
